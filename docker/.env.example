# Test-harness environment — copy to docker/.env and fill in.
# docker/.env itself stays git-ignored (the `.env` / `.env.*` rules); only
# this sample is tracked. Load it before the live tier:
#
#   source docker/.env && npm run test:live
#
# `docker compose` reads docker/.env on its own for ${VAR} interpolation, so
# `make e2e` works without sourcing — but then READER_* below must be plain
# values, not $-references, if your compose version does not expand them.
#
# These are throwaway test identities on a test homeserver only (AGENTS.md,
# rule 1). Provision them with the manifest shape in
# test/live/accounts-manifest.example.json. Never a real account.

# --- The test homeserver ---------------------------------------------------
export PI_MATRIX_HOMESERVER=https://matrix.example.org

# --- Actor 1: the agent (primary) account ----------------------------------
# The extension identity under test. Presents as a user+password pair here;
# a credentials.json path (PI_MATRIX_PRIMARY_CREDENTIALS) or a token also
# works — see docs/dev/testing.md.
export PI_MATRIX_USERNAME=pi_agent
export PI_MATRIX_PASSWORD='<from your secret store>'

# --- Actor 2: the human seat -----------------------------------------------
# The "human" who posts into the room during the scenarios. Also the Synapse
# admin identity docker/sweep-test-rooms.mjs needs for room purges.
export PI_MATRIX_SECOND_USER=you
export PI_MATRIX_SECOND_PASSWORD='<from your secret store>'
# Instead of the password pair, PI_MATRIX_SECOND_TOKEN='<access token>'
# works too — but a token expires with its session, a password does not.

# --- Actor 3: the crypto reader --------------------------------------------
# The reader is a separate DEVICE that decrypts Megolm
# so the scenario assertions can read the room. Needed whenever the
# homeserver auto-encrypts new rooms (a default-encryption Synapse); without
# it, sends fail with "configured to use encryption, but your client does
# not support encryption" and the suite cascades into timeouts.
# Reusing the primary account's login mints a fresh reader device per run —
# exactly what the live-nightly workflow does (it derives these two from the
# PI_MATRIX_USERNAME / PI_MATRIX_PASSWORD secrets; no extra secret needed).
# Set SWEEP_* below too if you run the room sweep.
export PI_MATRIX_READER_USER=<READER_USER>
export PI_MATRIX_READER_PASSWORD=<READER-PASSWORD>

# --- Optional ---------------------------------------------------------------
# LLM judge for `npm run test:live:judge` (any OpenAI-compatible server):
#export PI_MATRIX_JUDGE_BASE_URL=http://models.example.org:8000/v1
#export PI_MATRIX_JUDGE_MODEL=judge-model
#export PI_MATRIX_JUDGE_API_KEY= <JUDGE-API-KEY>

# A test homeserver that only speaks http:// on a non-local address needs an
# explicit opt-in (never applies to https://):
#export PI_MATRIX_ALLOW_INSECURE_HTTP=1

# --- Cleanup ---------------------------------------------------------------
# docker/sweep-test-rooms.mjs: purge agent-created e2e-*/live-e2e-*/optout-*
# rooms older than this many days:
#export SWEEP_TTL_DAYS=7
