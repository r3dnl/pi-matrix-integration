+// flagless set on the answer channel.
+const externalPartialHandler: Handler<"external_partial"> = (state, action, ctx) => {
+	const answers = new Map(state.answers);
+	for (const i of action.clears) answers.delete(i);
+	for (const a of action.answers) answers.set(a.questionIndex, a);
+	const next: QuestionnaireState = { ...state, answers };
+	const missing = ctx.questions.findIndex((_, i) => !answers.has(i));
+	return switchTabResult(next, missing === -1 ? ctx.questions.length : missing, ctx);
+};
