+
+/** Outcome of a validated PARTIAL set (patch A2.13-0001): the entries to
+ *  register and the question indexes to clear, as per-question
+ *  `QuestionAnswer` shapes — never a `QuestionnaireResult`. */
+export interface PartialAnswerOutcome {
+	ok: true;
+	answers: QuestionAnswer[];
+	clears: number[];
+}
+
+/**
+ * Patch A2.13-0001: validate a PARTIAL external set for display-sync
+ * (`payload.partial === true`). Same per-entry validation as
+ * `resolveExternalAnswer`, with two relaxations: the set need not be
+ * complete, and an entry carrying neither `optionIndexes` (or an empty
+ * array) nor `text` is a CLEAR — it removes that question's registered
+ * answer (the tap-toggle-off of a mirroring host). Display-only: it never
+ * settles the wait; the authoritative result still arrives as a complete
+ * flagless set through `resolveExternalAnswer`.
+ */
+export function resolvePartialAnswer(
+	questions: readonly QuestionData[],
+	payload: Record<string, unknown>,
+): PartialAnswerOutcome | { ok: false; code: AskUserAnswerRejectCode; reason: string } {
+	const { answers, cancel } = payload;
+	if (cancel === true) return { ok: false, code: "invalid_payload", reason: "cancel takes no partial" };
+	if (!Array.isArray(answers)) return { ok: false, code: "invalid_payload", reason: "answers must be an array" };
+	const byQuestion = new Map<number, Record<string, unknown>>();
+	for (const entry of answers) {
+		if (!isRecord(entry)) return { ok: false, code: "invalid_payload", reason: "each answer must be an object" };
+		const index = entry.questionIndex;
+		if (!Number.isInteger(index)) return { ok: false, code: "invalid_payload", reason: "questionIndex must be an integer" };
+		const i = index as number;
+		if (i < 0 || i >= questions.length) {
+			return { ok: false, code: "invalid_answer", reason: `questionIndex ${i} out of range (0..${questions.length - 1})` };
+		}
+		if (byQuestion.has(i)) return { ok: false, code: "invalid_answer", reason: `question ${i} answered twice` };
+		byQuestion.set(i, entry);
+	}
+	const resolved: QuestionAnswer[] = [];
+	const clears: number[] = [];
+	for (const [i, entry] of byQuestion) {
+		const picked = entry.optionIndexes;
+		const empty =
+			(picked === undefined || (Array.isArray(picked) && picked.length === 0)) && entry.text === undefined;
+		if (empty) {
+			clears.push(i);
+			continue;
+		}
+		const outcome = resolveEntry(questions[i]!, i, entry);
+		if (!outcome.ok) return outcome;
+		resolved.push(outcome.answer);
+	}
+	return { ok: true, answers: resolved, clears };
+}
