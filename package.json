{
  "name": "pi-matrix-integration",
  "version": "0.9.0",
  "description": "Matrix integration for the Pi coding agent",
  "main": "index.ts",
  "type": "module",
  "keywords": [
    "pi",
    "pi-package",
    "matrix",
    "integration",
    "chat",
    "messaging"
  ],
  "author": "Vincent Jansen",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r3dnl/pi-matrix-integration.git"
  },
  "homepage": "https://github.com/r3dnl/pi-matrix-integration#readme",
  "bugs": {
    "url": "https://github.com/r3dnl/pi-matrix-integration/issues"
  },
  "files": [
    "index.ts",
    "src",
    "agents",
    "docs",
    "!docs/assets/*.gif",
    "!docs/assets/*.png",
    "patches",
    "README.md",
    "QUICKSTART.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSES/Apache-2.0.txt",
    "NOTICE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@juicesharp/rpiv-voice": "*",
    "@tintinweb/pi-subagents": "*",
    "pi-subagents": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    },
    "@juicesharp/rpiv-voice": {
      "optional": true
    },
    "@tintinweb/pi-subagents": {
      "optional": true
    },
    "pi-subagents": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node test/run.mjs",
    "test:docs": "node test/docs-consistency.mjs",
    "test:repro": "node test/offline/load-check.mjs",
    "test:integration": "node test/integration/installed-patches.mjs && node test/integration/partial-channel.mjs",
    "test:logic": "node test/logic/00-core.mjs && node test/logic/01-threading.mjs && node test/logic/02-transport-footer.mjs && node test/logic/03-sdk-crypto.mjs",
    "test:live": "node test/live/scenarios.mjs",
    "test:live:judge": "node test/live/judge-summary.mjs",
    "test:perf": "node test/perf.mjs",
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "prepack": "npm run typecheck"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "pi-subagents": {
    "agents": [
      "./agents"
    ]
  },
  "dependencies": {
    "@matrix-org/matrix-sdk-crypto-wasm": "^18.9.0",
    "jsqr": "^1.4.0",
    "matrix-encrypt-attachment": "^1.0.3",
    "matrix-js-sdk": "^42.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "@eslint/js": "^10.0.1",
    "@juicesharp/rpiv-voice": "^2.15.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.14.0",
    "jiti": "^2.7.0",
    "typebox": "^1.4.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
