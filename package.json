{
  "name": "pi-matrix-integration",
  "version": "1.0.0",
  "description": "Matrix integration for the Pi coding agent",
  "main": "index.ts",
  "type": "module",
  "keywords": [
    "pi",
    "pi-package",
    "matrix",
    "integration",
    "chat",
    "messaging"
  ],
  "author": "Vincent Jansen",
  "license": "MIT",
  "peerDependencies": {
    "pi-subagents": "^0.80.0"
  },
  "scripts": {
    "test": "node test/run.mjs",
    "test:docs": "node test/docs-consistency.mjs",
    "test:repro": "node test/repro.mjs",
    "test:logic": "node test/test-logic.mjs",
    "test:live": "node test/live-check.mjs",
    "typecheck": "tsc -p .",
    "lint": "eslint ."
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "pi-subagents": {
    "agents": [
      "./agents"
    ]
  },
  "dependencies": {
    "@matrix-org/matrix-sdk-crypto-wasm": "^18.9.0",
    "jsqr": "^1.4.0",
    "matrix-encrypt-attachment": "^1.0.3",
    "matrix-js-sdk": "^42.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "@earendil-works/pi-tui": "^1.5.0",
    "@eslint/js": "^10.0.1",
    "@juicesharp/rpiv-voice": "^2.15.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.14.0",
    "typebox": "^1.4.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
