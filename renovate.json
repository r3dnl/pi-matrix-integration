{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":maintainLockFilesWeekly"
  ],
  "schedule": ["weekly"],
  "minimumReleaseAge": "7 days",
  "separateMajorMinor": true,
  "rangeStrategy": "auto",
  "packageRules": [
    {
      "description": "Host-provided peers are Pi's to update, not ours",
      "matchDepTypes": ["peerDependencies"],
      "enabled": false
    },
    {
      "description": "The crypto stack moves as one PR (matrix-js-sdk and its WASM bindings)",
      "matchPackageNames": [
        "matrix-js-sdk",
        "@matrix-org/matrix-sdk-crypto-wasm"
      ],
      "groupName": "matrix crypto stack",
      "groupSlug": "matrix-crypto-stack"
    },
    {
      "description": "Everything else: minors and patches grouped, majors separate",
      "matchDepTypes": ["dependencies", "devDependencies"],
      "excludePackageNames": [
        "matrix-js-sdk",
        "@matrix-org/matrix-sdk-crypto-wasm"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "minor and patch updates",
      "groupSlug": "minors-patches"
    },
    {
      "description": "Automerge is lockfile-only, after the CI gate is green (D-R4-13); version bumps wait for a human",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ]
}
